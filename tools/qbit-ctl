    # -- modals -----------------------------------------------------------------------------

    def modal(self, title, lines, width=64, buttons=None, sel=0, tone="accent"):
        """Centered box over the current frame. lines: [[(text, attr)]]."""
        C, scr = self.C, self.scr
        h, w = scr.getmaxyx()
        width = max(30, min(width, w - 4))
        room = max(1, h - 2 - 4 - (2 if buttons else 0))
        if len(lines) > room:
            lines = lines[:room - 1] + [[("… enlarge the terminal to see the rest", C["dim"])]]
        height = len(lines) + 4 + (2 if buttons else 0)
        y0 = max(0, (h - height) // 2)
        x0 = max(0, (w - width) // 2)
        for yy in range(y0, min(h, y0 + height)):
            put(scr, yy, x0, " " * width)
        b = C[tone] if tone in C else C["dim"]
        put(scr, y0, x0, "╭" + "─" * (width - 2) + "╮", b)
        for yy in range(y0 + 1, y0 + height - 1):
            put(scr, yy, x0, "│", b)
            put(scr, yy, x0 + width - 1, "│", b)
        put(scr, y0 + height - 1, x0, "╰" + "─" * (width - 2) + "╯", b)
        segs(scr, y0, x0 + 2, [(" ", b), (title, C["bold"]), (" ", b)], width - 4)
        for i, ln in enumerate(lines):
            segs(scr, y0 + 2 + i, x0 + 3, ln, width - 6)
        if buttons:
            bx = x0 + width - 3
            for i in reversed(range(len(buttons))):
                t = " %s " % buttons[i]
                bx -= dw(t)
                a = (C["chip"] if tone == "accent" else C["chipwarn"]) | curses.A_BOLD if i == sel else C["dim"]
                put(scr, y0 + height - 3, bx, t, a)
                bx -= 2

    def wrap(self, text, width, attr=None):
        attr = self.C["norm"] if attr is None else attr
        out = []
        for para in text.split("\n"):
            line = ""
            for word in para.split(" "):
                if line and dw(line) + 1 + dw(word) > width:
                    out.append([(line, attr)])
                    line = word
                else:
                    line = (line + " " + word) if line else word
            out.append([(line, attr)])
        return out

    def ask(self, title, text, buttons=("Cancel", "OK"), default=0, tone="accent", width=66, extra=None):
        """Button dialog; returns the chosen label, or None on Esc."""
        sel = default
        lines = self.wrap(text, width - 6) + (extra or [])
        while True:
            self.draw()
            self.modal(title, lines, width, list(buttons), sel, tone)
            curses.doupdate()
            k = getkey(self.scr)
            if k in (curses.KEY_LEFT, curses.KEY_BTAB, ord("h")):
                sel = (sel - 1) % len(buttons)
            elif k in (curses.KEY_RIGHT, 9, ord("l")):
                sel = (sel + 1) % len(buttons)
            elif k in (10, 13, curses.KEY_ENTER):
                return buttons[sel]
            elif k in (27, ord("q")):
                return None
            elif k == curses.KEY_RESIZE:
                continue
            else:
                for b in buttons:
                    if k in (ord(b[0].lower()), ord(b[0].upper())):
                        return b

    def tell(self, title, text, tone="accent", width=66):
        self.ask(title, text, ("OK",), 0, tone, width)

    def confirm_typed(self, title, text, word):
        """Destructive confirm: the operator types word. Returns True when it matches."""
        buf = ""
        while True:
            self.draw()
            lines = self.wrap(text, 60) + [[]] + [[("Type ", self.C["dim"]), (word, self.C["bold"]),
                                                    (" to continue, Esc to cancel.", self.C["dim"])]]
            lines.append([("› ", self.C["accent"] | curses.A_BOLD), (buf, self.C["bold"]), ("█", self.C["dim"])])
            self.modal(title, lines, 66, tone="err")
            curses.doupdate()
            k = getkey(self.scr)
            if k == 27:
                return False
            if k in (10, 13, curses.KEY_ENTER):
                if buf == word:
                    return True
                buf = ""
            elif k in (127, 8, curses.KEY_BACKSPACE):
                buf = buf[:-1]
            elif 32 <= k < 0x110000 and k not in range(curses.KEY_MIN, curses.KEY_MAX + 1) and len(buf) < 32:
                buf += chr(k)

    # -- actions ------------------------------------------------------------------------------

    def prompt(self, title, text, initial="", hints="", keys=None):
        """One-line text input; returns the text, None on Esc, or keys[k] for an extra control key."""
        keys = keys or {}
        buf = initial
        error = ""
        while True:
            self.draw()
            room = min(74, self.scr.getmaxyx()[1] - 4) - 6 - 4  # modal inner width minus "› " and cursor
            shown = buf
            if dw(shown) > room:
                while shown and dw(shown) > room - 1:
                    shown = shown[1:]
                shown = "…" + shown
            lines = self.wrap(text, 66) + [[], [("› ", self.C["accent"] | curses.A_BOLD), (shown, self.C["bold"]),
                                                ("█", self.C["dim"])],
                                               [(error, self.C["warn"])] if error else [],
                                               [("Enter confirm · Esc cancel · Ctrl-U clear" + hints, self.C["dim"])]]
            self.modal(title, lines, 74)
            curses.doupdate()
            k = getkey(self.scr)
            if k == 27:
                return None
            if k in keys:
                return keys[k]
            if k in (10, 13, curses.KEY_ENTER):
                if buf.strip():
                    return buf.strip()
                error = "Enter a directory, or press Esc to cancel."
                continue
            error = ""
            if k in (127, 8, curses.KEY_BACKSPACE):
                buf = buf[:-1]
            elif k == 21:  # Ctrl-U
                buf = ""
            elif 32 <= k < 0x110000 and not curses.KEY_MIN <= k <= curses.KEY_MAX and len(buf) < 255:
                buf += chr(k)

    def act_change_dir(self):
        global BACKUP_DIR, BACKUP_DIR_FROM
        saved = bool(read_config().get("backups", "dir", fallback="").strip())
        new = self.prompt("Backup directory", "Directory that holds the backup archives. Currently %s (set by %s)."
                          % (tilde(BACKUP_DIR), BACKUP_DIR_FROM), tilde(BACKUP_DIR),
                          " · Ctrl-R reset to default" if saved else "", {18: RESET} if saved else None)
        if new is RESET:
            self.act_reset_dir()
            return
        if not new:
            return
        path = norm_dir(new)
        if os.path.exists(path) and not os.path.isdir(path):
            self.tell("Not a directory", tilde(path), "err")
            return
        note = "" if os.path.isdir(path) else "\n\nIt does not exist yet; the first backup creates it."
        if E.get("QBIT_CTL_BACKUP_DIR"):
            note += "\n\nQBIT_CTL_BACKUP_DIR is set and wins over the saved default in new sessions."
        choice = self.ask("Backup directory", "Use this directory for backups?\n\n%s%s" % (tilde(path), note),
                          ("Cancel", "This session", "Save as default"), 2)
        if choice in (None, "Cancel"):
            return
        if choice == "Save as default":
            try:
                save_backup_dir(path)
            except OSError as e:
                self.tell("Could not save", "%s\n\n%s" % (tilde(CONFIG_FILE), e.strerror or e), "err")
                return
            BACKUP_DIR_FROM = tilde(CONFIG_FILE)
            self.say("Backups now go to %s (saved in %s)." % (tilde(path), tilde(CONFIG_FILE)))
        else:
            BACKUP_DIR_FROM = "this session"
            self.say("Backups go to %s for this session." % tilde(path))
        BACKUP_DIR = path
        self.backup_tbl.cur = 0
        self.refresh("backups")

    def act_reset_dir(self):
        global BACKUP_DIR, BACKUP_DIR_FROM
        if self.ask("Reset backup directory", "Remove the saved directory from %s and go back to the default, %s?"
                    % (tilde(CONFIG_FILE), DEFAULT_BACKUP_DIR), ("Cancel", "Reset"), 1) != "Reset":
            return
        try:
            clear_backup_dir()
        except OSError as e:
            self.tell("Could not save", "%s\n\n%s" % (tilde(CONFIG_FILE), e.strerror or e), "err")
            return
        BACKUP_DIR, BACKUP_DIR_FROM = resolve_backup_dir()
        extra = " (QBIT_CTL_BACKUP_DIR still applies)" if BACKUP_DIR_FROM == "QBIT_CTL_BACKUP_DIR" else ""
        self.say("Backups go to %s again%s." % (tilde(BACKUP_DIR), extra))
        self.backup_tbl.cur = 0
        self.refresh("backups")

    def act_backup(self):
        def fn(job):
            job.note = "Snapshotting database and copying files"
            return self.env.backup(BACKUP_DIR)
        path, err = self.busy("Creating backup", fn)
        if err:
            self.tell("Backup failed", err, "err")
            self.say("Backup failed: " + err, "err")
        else:
            self.say("Backup created: %s (%s)" % (os.path.basename(path), human(os.path.getsize(path))))
        self.refresh("backups")
        if self.stats is None:
            self.refresh("overview")

    def act_restore(self):
        if not self.backups:
            return
        path, size, mt = self.backups[self.backup_tbl.cur]
        name = os.path.basename(path)
        env = self.env
        if not env.container:
            self.tell("Restore unavailable", "No backend container found. Restore needs the container so it can be "
                      "stopped and started around the change.", "err")
            return
        files, err = self.busy("Checking archive", lambda job: env.verify_archive(path))
        if err:
            self.tell("Archive rejected", "%s\n\n%s" % (name, err), "err")
            return
        text = ("Replace all data in volume %s with:\n\n%s\n%s · created %s · %d .qgif files\n\n"
                "The backend is stopped, the current data is saved as a backup, then the archive is "
                "extracted. %s" % (env.volume, name, human(size), stamp(mt), files,
                                   "The backend is started again afterwards." if env.running
                                   else "The backend is stopped now and stays stopped."))
        if not self.confirm_typed("Restore backup", text, "restore"):
            self.say("Restore cancelled.", "warn")
            return

        def fn(job):
            job.note = "Stopping backend"
            env.refresh()  # the screen may be stale: decide on the current state
            was_running = env.running
            env.stop()  # no-op when already stopped
            job.note = "Saving current data"
            try:
                safety = env.backup(BACKUP_DIR, "pre-restore")
            except DockerError:
                if was_running:
                    env.start()
                raise
            job.note = "Replacing volume contents"
            try:
                env.replace_volume(path)
            except DockerError as e:
                job.note = "Restore failed; putting the previous data back"
                try:
                    env.replace_volume(safety)
                except DockerError as e2:
                    raise DockerError("%s\n\nRolling back also failed: %s\nThe backend is left stopped. Restore %s "
                                      "by hand." % (e, e2, os.path.basename(safety)))
                if was_running:
                    env.start()
                raise DockerError("%s\n\nThe previous data was put back%s." % (e, " and the backend is running"
                                                                                  if was_running else ""))
            if was_running:
                job.note = "Starting backend and waiting for the health check"
                env.start()
            return safety
        safety, err = self.busy("Restoring", fn, protect=True)
        self.refresh("all")
        if err:
            self.tell("Restore failed", err, "err")
            self.say("Restore failed: " + err, "err")
        else:
            self.say("Restored %s. Previous data saved as %s." % (name, os.path.basename(safety)))

    def act_delete_backup(self):
        if not self.backups:
            return
        path, size, mt = self.backups[self.backup_tbl.cur]
        name = os.path.basename(path)
        if len(self.backups) == 1:
            extra = [[("This is the only backup in this directory.", self.C["warn"])]]
        else:
            extra = None
        if self.ask("Delete backup", "Permanently delete %s (%s, created %s)?" % (name, human(size), stamp(mt)),
                    ("Cancel", "Delete"), 0, "err", extra=extra) != "Delete":
            return
        try:
            os.remove(path)
            self.say("Deleted %s." % name)
        except OSError as e:
            self.tell("Delete failed", "%s\n\n%s" % (name, e.strerror or e), "err")
        self.refresh("backups")

    def act_restart(self):
        env = self.env
        if not env.container:
            return
        verb = "Restart" if env.running else "Start"
        if self.ask(verb + " backend", "%s %s? Devices and browsers reconnect automatically; expect a few seconds "
                    "of downtime." % (verb, env.container), ("Cancel", verb), 0) != verb:
            return
        _, err = self.busy(verb + "ing backend", lambda job: env.restart() if env.running else env.start())
        self.refresh("all")
        if err:
            self.tell(verb + " failed", err, "err")
        else:
            self.say("Backend is %s." % self.env.state)

    def act_delete_library(self):
        t = self.lib_tbl
        if not t or not t.rows:
            return
        idx = sorted(t.marked) or [t.cur]
        items = [t.rows[i] for i in idx]
        names = ", ".join(cell(r[0]) for r in items[:3]) + (" and %d more" % (len(items) - 3) if len(items) > 3 else "")
        if self.ask("Delete library items", "Delete %d item%s from the library: %s?\n\nThis removes the database rows, "
                    "their stars and the .qgif files. It cannot be undone except by restoring a backup."
                    % (len(items), "" if len(items) == 1 else "s", names), ("Cancel", "Delete"), 0, "err") != "Delete":
            return
        ids = [r[6] for r in items]
        res, err = self.busy("Deleting", lambda job: self.env.delete_library(ids), protect=True)
        if err:
            self.tell("Delete failed", err + "\n\nThe deletion is all or nothing. Press R to see the current state.", "err")
            return
        t.marked.clear()
        self.refresh("library")
        self.say("Deleted %d row%s and %d file%s." % (res["rows"], "" if res["rows"] == 1 else "s",
                                                       res["files"], "" if res["files"] == 1 else "s"))
        if self.env.running and self.ask("Restart backend", "The website caches the library in memory. Restart "
                                          "the backend now so the deletion shows up?", ("Later", "Restart"), 0) == "Restart":
            _, err = self.busy("Restarting backend", lambda job: self.env.restart())
            self.refresh("all")
            self.say(("Restart failed: " + err) if err else "Backend restarted.", "err" if err else "ok")

    def act_shell(self):
