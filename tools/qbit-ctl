def main(argv=None):
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Operate the QBIT backend data volume: status, consistent backups, restore, "
                    "database browser and library cleanup. Run without a command for the interactive console.",
        epilog="Backup directory: --dir, else QBIT_CTL_BACKUP_DIR, else [backups] dir in %s, else %s. "
               "Other environment: QBIT_CTL_CONTAINER (default qbit-backend,qbit-backend-dev), QBIT_CTL_IMAGE "
               "(used when no container exists), NO_COLOR." % (tilde(CONFIG_FILE), DEFAULT_BACKUP_DIR),
    )
    ap.add_argument("--version", action="version", version="%s %s" % (PROG, VERSION))
    sub = ap.add_subparsers(dest="cmd", metavar="command")
    sub.add_parser("console", help="interactive console (default)")
    p = sub.add_parser("status", help="backend, volume, database and latest backup")
    p.add_argument("--dir", help="backup directory (default: %s, from %s)" % (tilde(BACKUP_DIR), BACKUP_DIR_FROM))
    p = sub.add_parser("backup", help="create a consistent backup without stopping the backend")
    p.add_argument("--dir", help="backup directory (default: %s, from %s)" % (tilde(BACKUP_DIR), BACKUP_DIR_FROM))
    p = sub.add_parser("backups", help="list backup archives, newest first")
    p.add_argument("--dir", help="backup directory (default: %s, from %s)" % (tilde(BACKUP_DIR), BACKUP_DIR_FROM))
    args = ap.parse_args(argv)
    if hasattr(args, "dir"):
        args.dir_from = "--dir" if args.dir else BACKUP_DIR_FROM
        args.dir = norm_dir(args.dir) if args.dir else BACKUP_DIR
    cmd = args.cmd or "console"
    return {"console": cmd_console, "status": cmd_status, "backup": cmd_backup, "backups": cmd_backups}[cmd](args)


if __name__ == "__main__":
    sys.exit(main())
