E = os.environ
CONTAINERS = [c for c in E.get("QBIT_CTL_CONTAINER", "qbit-backend,qbit-backend-dev").split(",") if c]
DEFAULT_BACKUP_DIR = "~/qbit_backups"
CONFIG_FILE = os.path.join(E.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "qbit-ctl", "config.ini")
BACKUP_PREFIX = "qbit-data-backup-"
BACKUP_SUFFIX = ".tar.gz"
