    def help(self):
        C = self.C
        sections = [
            ("Global", [("1-5  ← →", "switch tabs"), ("↑ ↓  j k", "move"), ("PgUp PgDn", "page"),
                        ("Home End", "first, last"), ("R", "refresh tab"), ("?", "this help"), ("q  Esc", "quit")]),
            ("Overview", [("b", "back up now"), ("s", "restart or start backend")]),
            ("Backups", [("b", "create backup"), ("Enter", "restore selected"), ("d", "delete selected"),
                         ("c", "change directory")]),
            ("Database", [("↑ ↓", "choose query"), ("Enter", "browse rows / back")]),
            ("Library", [("Space", "mark item"), ("a", "mark all / none"), ("d", "delete marked")]),
            ("Volume", [("o", "open shell in /data")]),
        ]
        kw, dw_ = 11, 26
        colw = 2 + kw + dw_

        def block(items):
            out = []
            for title, keys in items:
                if out:
                    out.append([])
                out.append([(title, C["bold"])])
                for k, d in keys:
                    out.append([("  " + pad(k, kw), C["accent"]), (pad(d, dw_), C["norm"])])
            return out

        h, w = self.scr.getmaxyx()
        if w >= 2 * colw + 12:
            left, right = block(sections[:3]), block(sections[3:])
            left += [[]] * (len(right) - len(left))
            right += [[]] * (len(left) - len(right))
            lines = [(l + [(" " * (colw - sum(dw(t) for t, _ in l)), 0), ("    ", 0)] + r) for l, r in zip(left, right)]
            width = 2 * colw + 4 + 6
        else:
            lines = block(sections)
            width = colw + 6
        lines += [[], [("Backups are written to ", C["dim"]), (tilde(BACKUP_DIR), C["norm"])],
                  [("Set by %s. Press c on the Backups tab to change it." % BACKUP_DIR_FROM, C["dim"])]]
        while True:
            self.draw()
            self.modal("Keys", lines, max(width, 60), ["Close"], 0)
            curses.doupdate()
            if getkey(self.scr) not in (curses.KEY_RESIZE, -1):
                return

    # -- loop ---------------------------------------------------------------------------------

    def current_table(self):
        name = TABS[self.tab][0]
        if name == "backups":
            return self.backup_tbl
        if name == "database" and self.query_focus:
            return self.query_tbl
        if name == "library":
            return self.lib_tbl
        if name == "volume":
            return self.vol_tbl
        return None

    def switch(self, i):
        self.tab = i % len(TABS)
        name = TABS[self.tab][0]
        if name not in self.loaded:
            self.load(name)

    def load(self, name):
        _, err = self.busy("Loading", lambda job: self.refresh(name), replay=True)
        if err:
            self.say(err, "err")

    def run(self):
        curses.curs_set(0)
        self.scr.keypad(True)
        self.load("overview")
        self.loaded.add("overview")
        while True:
            self.draw()
            curses.doupdate()
            k = getkey(self.scr, 1000)
            if k == -1:
                continue
            name = TABS[self.tab][0]
            t = self.current_table()
            h = self.scr.getmaxyx()[0]
            page = max(1, h - 12)
            if k in (ord("q"), 27):
                return 0
            if ord("1") <= k <= ord(str(len(TABS))):
                self.switch(k - ord("1"))
            elif k in (9, curses.KEY_RIGHT):
                self.switch(self.tab + 1)
            elif k in (curses.KEY_BTAB, curses.KEY_LEFT):
                self.switch(self.tab - 1)
            elif k == ord("R"):
                self.load(name)
                self.say("Refreshed.")
            elif k == ord("?"):
                self.help()
            elif k in (curses.KEY_UP, ord("k")):
                if name == "database" and not self.query_focus:
                    self.query_idx = (self.query_idx - 1) % len(QUERIES)
                    self.load("database")
                elif t:
                    t.move(-1)
            elif k in (curses.KEY_DOWN, ord("j")):
                if name == "database" and not self.query_focus:
                    self.query_idx = (self.query_idx + 1) % len(QUERIES)
                    self.load("database")
                elif t:
                    t.move(1)
            elif k == curses.KEY_NPAGE and t:
                t.move(page)
            elif k == curses.KEY_PPAGE and t:
                t.move(-page)
            elif k == curses.KEY_HOME and t:
                t.cur = 0
            elif k == curses.KEY_END and t:
                t.cur = max(0, len(t.rows) - 1)
            elif k == ord("b") and name in ("overview", "backups"):
                self.act_backup()
            elif k == ord("s") and name == "overview":
                self.act_restart()
            elif name == "backups" and k in (10, 13, curses.KEY_ENTER):
                self.act_restore()
            elif name == "backups" and k == ord("d"):
                self.act_delete_backup()
            elif name == "backups" and k == ord("c"):
                self.act_change_dir()
            elif name == "database" and k in (10, 13, curses.KEY_ENTER):
                self.query_focus = not self.query_focus and bool(self.query_tbl and self.query_tbl.rows)
            elif name == "library" and k == ord(" ") and t and t.rows:
                t.marked ^= {t.cur}
                t.move(1)
            elif name == "library" and k == ord("a") and t:
                t.marked = set() if len(t.marked) == len(t.rows) else set(range(len(t.rows)))
            elif name == "library" and k == ord("d"):
                self.act_delete_library()
            elif name == "volume" and k == ord("o"):
                self.act_shell()


def cmd_console(args):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        fail("the console needs a terminal; use `%s status` or `%s backup` in scripts" % (PROG, PROG), 2)
    os.environ.setdefault("ESCDELAY", "25")
    signal.signal(signal.SIGHUP, lambda *a: sys.exit(129))
    try:
        return curses.wrapper(lambda scr: App(scr).run())
    except KeyboardInterrupt:
        return 130


