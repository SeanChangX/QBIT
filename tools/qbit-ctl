# QBIT web palette (web/frontend/src/App.css) mapped to xterm-256:
#   --red-light #ff4d4d → 203   --red #d32f2f → 160   --text-muted #888 → 245
#   --border #333 → 237          --text-secondary #e0e0e0 → 254
PALETTE = {"accent": (203, curses.COLOR_RED), "deep": (160, curses.COLOR_RED), "dim": (245, -1),
           "rule": (237, -1), "text": (254, -1), "ok": (114, curses.COLOR_GREEN),
           "warn": (179, curses.COLOR_YELLOW), "err": (203, curses.COLOR_RED)}


def colours():
    C = {"norm": curses.A_NORMAL, "bold": curses.A_BOLD}
    plain = bool(E.get("NO_COLOR")) or not curses.has_colors()
    if not plain:
        try:
            curses.use_default_colors()
        except curses.error:
            pass
    rich = not plain and curses.COLORS >= 256
    n = 1
    for k, (c256, c8) in PALETTE.items():
        attr = curses.A_DIM if k in ("dim", "rule") else curses.A_NORMAL
        if not plain and (rich or c8 >= 0):
            try:
                curses.init_pair(n, c256 if rich else c8, -1)
                attr = curses.color_pair(n)
            except (curses.error, ValueError):
                pass
            n += 1
        C[k] = attr
    # inverse chips: dark text on a coloured background
    # chip: white on --red (#d32f2f → 160), like the site's buttons
    for k, (c256, c8) in (("chip", (160, curses.COLOR_RED)), ("chipok", (114, curses.COLOR_GREEN)),
                          ("chipwarn", (179, curses.COLOR_YELLOW)), ("sel", (237, curses.COLOR_WHITE))):
        attr = curses.A_REVERSE
        if not plain:
            try:
                fg = (255 if k in ("chip", "sel") else 16) if rich else (
                    curses.COLOR_WHITE if k == "chip" else curses.COLOR_BLACK)
                curses.init_pair(n, fg, c256 if rich else c8)
                attr = curses.color_pair(n)
            except (curses.error, ValueError):
                pass
            n += 1
        C[k] = attr
    return C


def put(win, y, x, s, attr=0, maxw=None):
    h, w = win.getmaxyx()
    if y < 0 or y >= h or x >= w - 1 or x < 0:
        return 0
    room = w - x - 1 if maxw is None else min(maxw, w - x - 1)
    s = clip(s, room)
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass
    return dw(s)


def segs(win, y, x, parts, maxw=None):
    """Write [(text, attr)] left to right; returns the end column."""
    end = x + (maxw if maxw is not None else 10 ** 6)
    for t, a in parts:
        if x >= end:
            break
        x += put(win, y, x, t, a, end - x)
    return x


def seg_width(parts):
    return sum(dw(t) for t, _ in parts)


def box(win, y, x, h, w, C, title="", right=None, focus=True):
    b = C["dim"] if focus else C["rule"]
    if h < 2 or w < 4:
        return
    put(win, y, x, "╭" + "─" * (w - 2) + "╮", b)
    for i in range(1, h - 1):
        put(win, y + i, x, "│", b)
        put(win, y + i, x + w - 1, "│", b)
    put(win, y + h - 1, x, "╰" + "─" * (w - 2) + "╯", b)
    if title:
        segs(win, y, x + 2, [(" ", b), (title, C["bold"] if focus else C["dim"]), (" ", b)], w - 4)
    if right:
        rw = seg_width(right) + 2
        if rw < w - 6 - dw(title):
            segs(win, y, x + w - 2 - rw, [(" ", b)] + right + [(" ", b)])


_CSI = {"A": curses.KEY_UP, "B": curses.KEY_DOWN, "C": curses.KEY_RIGHT, "D": curses.KEY_LEFT,
        "H": curses.KEY_HOME, "F": curses.KEY_END, "Z": curses.KEY_BTAB}
_TILDE = {"1": curses.KEY_HOME, "7": curses.KEY_HOME, "4": curses.KEY_END, "8": curses.KEY_END,
          "5": curses.KEY_PPAGE, "6": curses.KEY_NPAGE, "3": curses.KEY_DC}


def getkey(scr, wait=-1):
    """One key as an int (curses.KEY_* or a code point); -1 when wait (ms) runs out.

    keypad() only decodes the sequences terminfo lists (ESC O B for xterm), while tmux and many
    ssh clients send ESC [ B. Decode both here so arrows never arrive as a bare Esc (= quit)."""
    scr.timeout(wait)
    try:
        k = scr.get_wch()
    except curses.error:
        return -1
    k = ord(k) if isinstance(k, str) else k
    if k != 27:
        return k
    scr.timeout(30)
    seq = ""
    try:
        while len(seq) < 6:
            try:
                c = scr.get_wch()
            except curses.error:
                break
            if not isinstance(c, str):
                break
            seq += c
            if seq[0] not in "[O" or (len(seq) > 1 and (c.isalpha() or c == "~")):
                break
    finally:
        scr.timeout(wait)
    if not seq:
        return 27
    if seq[0] in "[O" and seq[-1] in _CSI:
        return _CSI[seq[-1]]
    if seq[0] == "[" and seq.endswith("~") and seq[1:-1] in _TILDE:
        return _TILDE[seq[1:-1]]
    return -1  # unknown sequence: ignore rather than treat as Esc


class Table:
    """A scrollable, optionally multi-select table with display-width aware columns."""

    def __init__(self, cols, rows, aligns=None, keys=None):
        self.cols = cols
        self.rows = rows
        self.aligns = aligns or [False] * len(cols)
        self.keys = keys
        self.cur = 0
        self.top = 0
        self.marked = set()

    def widths(self, room):
        sample = self.rows[:500]
        natural = [max([dw(c)] + [dw(cell(r[i])) for r in sample]) for i, c in enumerate(self.cols)]
        gap = 2 * (len(self.cols) - 1)
        if sum(natural) + gap <= room:
            return natural  # everything fits: never truncate
        # too wide: cap outliers (long descriptions, emails) first, then shrink the widest
        # columns, never below the header or 6 columns
        ws = [min(n, 48) for n in natural]
        while sum(ws) + gap > room:
            i = max(range(len(ws)), key=lambda k: ws[k] - max(6, min(dw(self.cols[k]), 12)))
            floor = max(6, min(dw(self.cols[i]), 12))
            if ws[i] <= floor:
                break
            ws[i] -= 1
        spare = room - gap - sum(ws)
        for i in sorted(range(len(ws)), key=lambda k: natural[k] - ws[k], reverse=True):
            if spare <= 0:
                break
            give = min(spare, natural[i] - ws[i])
            ws[i] += give
            spare -= give
        return ws

    def move(self, d, page=1):
        if not self.rows:
            return
        self.cur = max(0, min(len(self.rows) - 1, self.cur + d))

    def draw(self, win, y, x, h, w, C, multi=False, focus=True):
        if not self.rows:
            put(win, y + 1, x + 2, "No rows.", C["dim"])
            return
        lead = 6 if multi else 2
        ws = self.widths(w - lead)
        hdr = [("  " if not multi else "      ", 0)]
        for i, c in enumerate(self.cols):
            hdr.append((pad(c, ws[i], self.aligns[i]) + ("  " if i < len(ws) - 1 else ""), C["dim"] | curses.A_BOLD))
        segs(win, y, x, hdr, w)
        body = h - 1
        if self.cur < self.top:
            self.top = self.cur
        elif self.cur >= self.top + body:
            self.top = self.cur - body + 1
        for j, r in enumerate(self.rows[self.top:self.top + body]):
            i = self.top + j
            on = i == self.cur and focus
            base = C["sel"] if on else C["norm"]
            line = [("▌ " if on else "  ", C["accent"] if on else 0)]
            if multi:
                on_mark = i in self.marked
                line.append(("[x] " if on_mark else "[ ] ", (C["accent"] | curses.A_BOLD) if on_mark else C["dim"]))
            for k, v in enumerate(r):
                a = base
                if v is None and not on:
                    a = C["rule"]
                line.append((pad(cell(v), ws[k], self.aligns[k]) + ("  " if k < len(ws) - 1 else ""), a))
            end = segs(win, y + 1 + j, x, line, w)
            if on and end < x + w:
                put(win, y + 1 + j, end, " " * (x + w - end), base)
        if len(self.rows) > body:
            pos = "%d/%d" % (self.cur + 1, len(self.rows))
            put(win, y + h, x + w - dw(pos) - 1, pos, C["dim"])


class Job:
    """Run fn in a thread; the UI keeps drawing a spinner until it is done."""

    def __init__(self, title, fn):
        self.title = title
        self.note = ""
        self.result = None
        self.error = None
        self.done = False
        self.t0 = time.time()

        def run():
            try:
                self.result = fn(self)
            except Exception as e:  # noqa: BLE001 - shown to the operator verbatim
                self.error = str(e) or e.__class__.__name__
            self.done = True

        threading.Thread(target=run, daemon=True).start()


class App:
    def __init__(self, scr):
        self.scr = scr
        self.C = colours()
        self.env = Env()
        self.tab = 0
        self.status = ("", 0, 0.0)
        self.stats = None
        self.stats_err = None
        self.backups = []
        self.backup_tbl = Table(["Archive", "Size", "Created", "Age"], [], [False, True, False, False])
        self.query_idx = 0
        self.query_focus = False
        self.query_tbl = None
        self.query_err = None
        self.lib_tbl = None
        self.lib_err = None
        self.ls = None
        self.ls_err = None
        self.vol_tbl = None
        self.loaded = set()

    # -- status line --------------------------------------------------------------

    def say(self, msg, kind="ok"):
        self.status = (msg, kind, time.time())

    # -- data loading ---------------------------------------------------------------

    def refresh(self, what=None):
        self.env.refresh()
        what = what or TABS[self.tab][0]
        if what in ("overview", "all"):
            self.stats, self.stats_err = None, None
            try:
                self.stats = self.env.stats()
            except DockerError as e:
                self.stats_err = str(e)
        if what in ("overview", "backups", "all"):
            self.backups = backups()
            self.backup_tbl.rows = [[os.path.basename(p), human(s), stamp(m), ago(m)] for p, s, m in self.backups]
            self.backup_tbl.cur = min(self.backup_tbl.cur, max(0, len(self.backups) - 1))
        if what == "database":
            self.run_query()
        if what == "library":
            self.lib_err = None
            try:
                r = self.env.query("SELECT filename, uploader, size, frameCount, downloadCount, uploadedAt, id "
                                   "FROM library ORDER BY uploadedAt DESC")
                self.lib_tbl = Table(["File", "Uploader", "Size", "Frames", "Downloads", "Uploaded", "ID"],
                                     [[a, b, human(c), d, e, f, g] for a, b, c, d, e, f, g in r["rows"]],
                                     [False, False, True, True, True, False, False])
            except DockerError as e:
                self.lib_err, self.lib_tbl = str(e), None
        if what == "volume":
            self.ls_err = None
            try:
                self.ls = self.env.listing()
                rows = [["/data/" + n, human(s) if s is not None else "", stamp(m)] for n, s, m in (self.ls.get("data") or [])]
                files = self.ls.get("files") or []
                rows += [["/data/files/" + n, human(s) if s is not None else "", stamp(m)] for n, s, m in files[:2000]]
                self.vol_tbl = Table(["Path", "Size", "Modified"], rows, [False, True, False])
            except DockerError as e:
                self.ls_err, self.vol_tbl = str(e), None
        self.loaded.add(what)

    def run_query(self):
        key, title, sql, cols = QUERIES[self.query_idx]
        self.query_err = None
        try:
            r = self.env.query(sql)
            rows = r["rows"]
            if key == "library":
                rows = [[a, b, human(c), d, e, f, g] for a, b, c, d, e, f, g in rows]
            aligns = [isinstance(v, (int, float)) for v in (rows[0] if rows else [])] or None
            if key == "library":
                aligns = [False, False, True, True, True, False, False]
            self.query_tbl = Table(cols, rows, aligns)
        except DockerError as e:
            self.query_err, self.query_tbl = str(e), None

    def busy(self, title, fn, replay=False, protect=False):
        """Run fn in a Job with a spinner modal; returns (result, error).

        replay: keys typed meanwhile are replayed afterwards (loads only; for actions they could
        answer the next dialog, so they are discarded). protect: ignore Ctrl-C, SIGHUP and SIGTERM
        until the job ends, so a dropped ssh session cannot stop a restore halfway. Ignored signals
        stay ignored in the docker clients started meanwhile, which keeps their containers running."""
        saved = {}
        if protect:
            for sig in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM):
                saved[sig] = signal.signal(sig, signal.SIG_IGN)
        job = Job(title, fn)
        typed = []
        while not job.done:
            self.draw()
            el = time.time() - job.t0
            if el > 0.3:  # quick loads finish without a flash of the dialog
                lines = [[(SPIN[int(el * 10) % len(SPIN)] + " ", self.C["accent"]),
                          (job.note or "Working", self.C["norm"]), ("  %ds" % el, self.C["dim"])]]
                self.modal(title, lines, width=60)
            curses.doupdate()
            k = getkey(self.scr, 100)
            if k not in (-1, curses.KEY_RESIZE) and len(typed) < 8:
                typed.append(k)
        for sig, handler in saved.items():
            signal.signal(sig, handler)
        if replay:
            for k in reversed(typed):
                curses.ungetch(k)
        else:
            curses.flushinp()
        return job.result, job.error

    # -- drawing ----------------------------------------------------------------------

    def frame(self):
        h, w = self.scr.getmaxyx()
        return h, w, w  # full width, like k9s / lazydocker

    def draw(self):
        C, scr = self.C, self.scr
        scr.erase()
        h, w, width = self.frame()
        if h < MIN_H or w < MIN_W:
            put(scr, h // 2 - 1, 2, "Terminal too small: need %d×%d, have %d×%d" % (MIN_W, MIN_H, w, h), C["warn"])
            put(scr, h // 2, 2, "Enlarge the window, or press q to quit.", C["dim"])
            scr.noutrefresh()
            return
        env = self.env
        # one blank row above the header when there is room (< 24 rows: give it to the body)
        t0 = 1 if h >= 24 else 0
        # name + state chip on the right
        segs(scr, t0, 2, [(PROG, C["bold"]), ("  v" + VERSION + "  ·  QBIT data control", C["dim"])])
        st = env.state
        chip = {"healthy": "chipok", "running": "chipok", "starting": "chipwarn", "stopped": "chipwarn"}.get(st, "chip")
        label = " %s " % ("backend " + st)
        put(scr, t0, width - dw(label) - 2, label, C[chip] | curses.A_BOLD)
        # facts joined with ·
        facts = [env.container or "no backend container", env.volume or "no volume"]
        if env.image_name:
            facts.append(env.image_name + (" @" + env.image[7:19] if env.image else ""))
        if env.started:
            facts.append("up " + ago(env.started).replace(" ago", ""))
        put(scr, t0 + 1, 2, "  ·  ".join(facts), C["dim"], width - 4)
        # tabs
        x = 2
        for i, (_, name) in enumerate(TABS):
            t = " %d %s " % (i + 1, name)
            if i == self.tab:
                put(scr, t0 + 3, x, t, C["chip"] | curses.A_BOLD)
            else:
                segs(scr, t0 + 3, x, [(" %d " % (i + 1), C["dim"]), (name + " ", C["norm"])])
            x += dw(t) + 1
        put(scr, t0 + 4, 1, "─" * (width - 2), C["rule"])
        # body
        top, bottom = t0 + 5, h - 3
        getattr(self, "draw_" + TABS[self.tab][0])(top, 1, bottom - top, width - 2)
        # footer: keys + status
        put(scr, h - 3, 1, "─" * (width - 2), C["rule"])
        keys = self.keys()
        line = []
        for i, (k, d) in enumerate(keys):
            if i:
                line.append(("   ", 0))
            line += [(k, C["accent"] | curses.A_BOLD), (" " + d, C["dim"])]
        segs(scr, h - 2, 2, line, width - 4)
        msg, kind, t = self.status
        if msg and time.time() - t < STATUS_HOLD:
            put(scr, h - 1, 2, msg, {"ok": C["ok"], "warn": C["warn"], "err": C["err"]}[kind], width - 4)
        scr.noutrefresh()

    def keys(self):
        name = TABS[self.tab][0]
        common = [("R", "refresh"), ("?", "help"), ("q", "quit")]
        per = {
            "overview": [("b", "backup now"), ("s", "restart backend")],
            "backups": [("↑↓", "select"), ("b", "new"), ("⏎", "restore"), ("d", "delete"), ("c", "directory")],
            "database": [("↑↓", "query" if not self.query_focus else "rows"), ("⏎", "open" if not self.query_focus else "back")],
            "library": [("↑↓", "select"), ("space", "mark"), ("a", "all"), ("d", "delete marked")],
            "volume": [("↑↓", "scroll"), ("o", "open shell")],
        }[name]
        return per + common

    def draw_overview(self, y, x, h, w):
        C, scr, env = self.C, self.scr, self.env
        lw = (w - 1) // 2
        rw = w - lw - 1
        box(scr, y, x, h, lw, C, "Backend")
        rows = [("Container", env.container or "-"),
                ("State", None),
                ("Image", env.image_name or "-"),
                ("Image ID", (env.image or "-")[7:19] if env.image else "-"),
                ("Volume", env.volume or "not found"),
                ("Up since", (stamp(env.started) + "  " + ago(env.started)) if env.started else "-")]
        for i, (k, v) in enumerate(rows):
            yy = y + 1 + i
            put(scr, yy, x + 2, pad(k, 12), C["dim"])
            if v is None:
                st = env.state
                a = C["ok"] if st in ("healthy", "running") else C["warn"] if st in ("starting", "stopped") else C["err"]
                put(scr, yy, x + 14, "● " + st, a | curses.A_BOLD)
            else:
                put(scr, yy, x + 14, v, C["norm"], lw - 16)
        yy = y + 2 + len(rows)
        put(scr, yy, x + 2, "Latest backup", C["bold"])
        if self.backups:
            p, s, m = self.backups[0]
            stale = time.time() - m > 7 * 86400
            put(scr, yy + 1, x + 2, os.path.basename(p), C["norm"], lw - 4)
            put(scr, yy + 2, x + 2, "%s · %s" % (human(s), ago(m)), C["warn"] if stale else C["dim"], lw - 4)
