COLOR_OUT = sys.stdout.isatty() and not E.get("NO_COLOR")


def sgr(code, text, on=None):
    on = COLOR_OUT if on is None else on
    return "\033[%sm%s\033[0m" % (code, text) if on else text


def bold(t):
    return sgr("1", t)


def dim(t):
    return sgr("38;5;245", t)


def red(t):
    return sgr("38;5;203", t)


def green(t):
    return sgr("38;5;114", t)


def amber(t):
    return sgr("38;5;179", t)


def fail(msg, code=1):
    sys.stderr.write("%s %s\n" % (sgr("1;38;5;203", "error:", COLOR_OUT and sys.stderr.isatty()), msg))
    sys.exit(code)


def state_text(env):
    s = env.state
    paint = green if s in ("healthy", "running") else amber if s in ("starting", "stopped") else red
    return paint(s)


